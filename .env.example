# ─────────────────────────────────────────────────────────────────────────────
# ROYALWEB AUTOPILOT — environment configuration
# Copy to .env.local and fill in what you need. Everything except the admin
# account is optional: the app runs with the built-in template engine and
# manual publishing if no AI/OAuth credentials are present.
# ─────────────────────────────────────────────────────────────────────────────

# First administrator (created automatically on first boot if no user exists).
# Leave blank and the /login screen will offer a first-run setup form instead.
ROYALWEB_ADMIN_EMAIL=
ROYALWEB_ADMIN_PASSWORD=
ROYALWEB_ADMIN_NAME=ROYALWEB Admin

# 32-byte key (base64 or 64-char hex) used to encrypt platform credentials at rest.
# Generate with: openssl rand -base64 32
# If unset, a key file is generated at data/.keys/master.key (0600).
ROYALWEB_ENCRYPTION_KEY=

# Public origin of the deployment. REQUIRED for:
#  - platform image URLs (Pinterest, Blogger, Ghost covers, Google posts)
#  - OAuth redirect URIs
# Example: https://autopilot.royalweb.in
PUBLIC_BASE_URL=

# Shared secret for the external worker / cron endpoint POST /api/worker/tick
ROYALWEB_WORKER_SECRET=

# Storage location (defaults to ./data)
# ROYALWEB_DATA_DIR=
# ROYALWEB_DB_PATH=

# ── AI provider (optional) ───────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. You can also set these in the dashboard
# (Settings → AI), where they are stored encrypted in the database.
ROYALWEB_AI_API_KEY=
# ROYALWEB_AI_BASE_URL=https://api.openai.com/v1

# ── Outbound email (optional) ────────────────────────────────────────────────
# Send from a mailbox you own and verify. Use an app password, never your login
# password. You can also enter these in Settings → Email (stored encrypted).
ROYALWEB_SMTP_HOST=
ROYALWEB_SMTP_PORT=587
ROYALWEB_SMTP_USER=
ROYALWEB_SMTP_PASS=
ROYALWEB_EMAIL_FROM=
ROYALWEB_EMAIL_FROM_NAME=ROYALWEB
ROYALWEB_EMAIL_REPLY_TO=
ROYALWEB_EMAIL_POSTAL_ADDRESS=
ROYALWEB_EMAIL_UNSUBSCRIBE_URL=

# ── OAuth applications (optional) ────────────────────────────────────────────
# Client IDs/secrets can also be entered in Settings → Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=

# LinkedIn API version header (yyyyMM). Update when LinkedIn retires a version.
# LINKEDIN_API_VERSION=202411

# Path to a system ffmpeg binary for YouTube Shorts rendering.
# Without it, poster→video rendering is disabled and reported honestly.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Disable the in-process worker (defaults to enabled).
# ROYALWEB_DISABLE_WORKER=0
