# ─────────────────────────────────────────────────────────────────────────────
# ROYALWEB AUTOPILOT — environment configuration
# Copy to .env.local and fill in what you need. Everything except the admin
# account is optional: the app runs with the built-in template engine and
# manual publishing if no AI/OAuth credentials are present.
# ─────────────────────────────────────────────────────────────────────────────

# First administrator (created automatically on first boot if no user exists).
# Leave blank and the /login screen will offer a first-run setup form instead.
ROYALWEB_ADMIN_EMAIL=
ROYALWEB_ADMIN_PASSWORD=
ROYALWEB_ADMIN_NAME=ROYALWEB Admin

# 32-byte key (base64 or 64-char hex) used to encrypt platform credentials at rest.
# Generate with: openssl rand -base64 32
# If unset, a key file is generated at data/.keys/master.key (0600).
ROYALWEB_ENCRYPTION_KEY=

# Public origin of the deployment. REQUIRED for:
#  - platform image URLs (Pinterest, Blogger, Ghost covers, Google posts)
#  - OAuth redirect URIs
# Example: https://autopilot.royalweb.in
PUBLIC_BASE_URL=

# Shared secret for the external worker / cron endpoint POST /api/worker/tick
ROYALWEB_WORKER_SECRET=

# Storage location (defaults to ./data)
# ROYALWEB_DATA_DIR=
# ROYALWEB_DB_PATH=

# ── AI provider (optional) ───────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works. You can also set these in the dashboard
# (Settings → AI), where they are stored encrypted in the database.
ROYALWEB_AI_API_KEY=
# ROYALWEB_AI_BASE_URL=https://api.openai.com/v1

# ── Outbound email (optional) ────────────────────────────────────────────────
# Send from a mailbox you own and verify. Use an app password, never your login
# password. You can also enter these in Settings → Email (stored encrypted).
ROYALWEB_SMTP_HOST=
ROYALWEB_SMTP_PORT=587
ROYALWEB_SMTP_USER=
ROYALWEB_SMTP_PASS=
ROYALWEB_EMAIL_FROM=
ROYALWEB_EMAIL_FROM_NAME=ROYALWEB
ROYALWEB_EMAIL_REPLY_TO=
ROYALWEB_EMAIL_POSTAL_ADDRESS=
ROYALWEB_EMAIL_UNSUBSCRIBE_URL=

# ── Platform accounts (optional, pre-filled on first run) ────────────────────
# Whatever is defined here is stored encrypted during first-run setup, so a
# fresh database does not mean retyping 25 sets of credentials. Seeded accounts
# are created as "unverified": press Verify once (no retyping) before publishing.
#
# Either one JSON object for all platforms:
# ROYALWEB_CREDENTIALS={"wordpress":{"siteUrl":"https://example.com","username":"editor","appPassword":"xxxx xxxx"},"bluesky":{"handle":"name.bsky.social","appPassword":"xxxx-xxxx-xxxx-xxxx"}}
#
# …or one variable per credential field (field names are the ones shown in
# Connect account, uppercased with underscores):
# ROYALWEB_WORDPRESS_SITE_URL=
# ROYALWEB_WORDPRESS_USERNAME=
# ROYALWEB_WORDPRESS_APP_PASSWORD=
# ROYALWEB_TELEGRAM_BOT_TOKEN=
# ROYALWEB_TELEGRAM_CHAT_ID=
# ROYALWEB_MASTODON_HOST=
# ROYALWEB_MASTODON_ACCESS_TOKEN=
# Optional: ROYALWEB_<PLATFORM>_ACCOUNT_NAME to label the account yourself.
# Optional: ROYALWEB_<PLATFORM>_TOKEN_EXPIRES_AT (ISO date) for OAuth tokens.
#
# Set to 1 to disable pre-filling entirely.
# ROYALWEB_DISABLE_ENV_SEED=0

# ── OAuth applications (optional) ────────────────────────────────────────────
# Client IDs/secrets can also be entered in Settings → Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=

# LinkedIn API version header (yyyyMM). Update when LinkedIn retires a version.
# LINKEDIN_API_VERSION=202411

# Path to a system ffmpeg binary for YouTube Shorts rendering.
# Without it, poster→video rendering is disabled and reported honestly.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Disable the in-process worker (defaults to enabled).
# ROYALWEB_DISABLE_WORKER=0

# --- Automation -----------------------------------------------------------------
# Telegram Bot API base (override only for local testing).
# ROYALWEB_TELEGRAM_API_BASE=https://api.telegram.org

# Allow RSS feeds and images on private/loopback addresses (local testing ONLY —
# leaving this on lets user-supplied feed URLs reach your internal network).
# ROYALWEB_ALLOW_PRIVATE_FETCH=0

# Passphrase for `npm run db:restore` (otherwise prompted for).
# ROYALWEB_SNAPSHOT_PASSPHRASE=

# --- Deployment -------------------------------------------------------------
# Shared secret for the cron-driven worker on serverless hosts. Vercel sends it
# as `Authorization: Bearer <CRON_SECRET>`; without it the cron endpoints refuse.
# CRON_SECRET=

# Alternative header secret for an external scheduler (x-worker-secret).
# ROYALWEB_WORKER_SECRET=

# Data directory (database, uploads, snapshots). Docker image uses /app/data.
# Point this at a persistent volume on any host — never at a serverless /tmp.
# ROYALWEB_DATA_DIR=/app/data

# Use DELETE journal mode when the database sits on a network volume (WAL needs
# shared memory and is not safe there).
# ROYALWEB_SQLITE_JOURNAL=delete

# Public HTTPS origin (List-Unsubscribe, OAuth redirect URIs, image URLs).
# PUBLIC_BASE_URL=https://app.yourdomain.in
